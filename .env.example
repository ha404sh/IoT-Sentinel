# IoT Sentinel — Environment Configuration
# Copy to .env and adjust. DO NOT commit .env.

# --- MQTT (Stage A) ---
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_ALLOW_ANONYMOUS=true

# --- MQTT (Stage B) ---
MQTT_TLS_PORT=8883
MQTT_USE_TLS=false
MQTT_CA_CERT=certificates/ca/ca.crt
MQTT_CLIENT_CERT=certificates/clients/temp01.crt
MQTT_CLIENT_KEY=certificates/clients/temp01.key
MQTT_USERNAME=
MQTT_PASSWORD=

# --- Detection thresholds ---
TEMP_ANOMALY_THRESHOLD=50
HUM_ANOMALY_THRESHOLD=95
RATE_ANOMALY_MULTIPLIER=10
RATE_WINDOW_MS=60000

# --- Risk bands ---
RISK_THRESHOLD_HIGH=60
RISK_THRESHOLD_CRITICAL=80

# --- Correlation ---
CORRELATION_WINDOW_MS=60000

# --- Database ---
DB_PATH=database/iot_sentinel.db
